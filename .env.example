# ECS — Project Analysis System Environment Configuration

# Application
APP_NAME="ECS — PROJECT ANALYSIS SYSTEM"
APP_TAGLINE="Intelligent Project Similarity Analysis. Transparent. Evidence-Based."
APP_VERSION="1.0.0"

# Server Ports and Host
HOST="0.0.0.0"
PORT=8000

# Storage & Retention
MAX_FILE_SIZE_MB=50
MAX_PAGE_LIMIT=300
MAX_BATCH_SIZE=500
RETENTION_HOURS=48
RATE_LIMIT_PER_MINUTE=60

# Asynchronous Background Queue (Redis + Celery)
# Leave USE_IN_MEMORY_QUEUE=true for zero-setup local dev, or false when running with Redis/Docker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
USE_IN_MEMORY_QUEUE=true
CONCURRENT_WORKERS=8

# Source Connectors (All are free/zero-cost)
# GitHub token is optional but raises hourly API rate limit from 60 to 5,000 req/hr
GITHUB_TOKEN=""

# Self-hosted SearXNG instance (Optional - DuckDuckGo is active by default)
SEARXNG_URL=""

# Crossref Academic Contact (Polite pool access for scholarly queries)
CROSSREF_MAILTO="ecs-project@analysis.org"

# AI Model Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
DEVICE="cpu"
