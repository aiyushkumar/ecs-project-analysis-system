# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.env
.venv
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache

# Storage & Temporary Files (Keep folders via .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/temp/*
!storage/temp/.gitkeep
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm

# OS / Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
